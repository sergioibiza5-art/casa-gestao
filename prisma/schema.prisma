generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Expense {
  id        String   @id @default(cuid())
  date      DateTime
  person    String
  place     String
  category  String
  amount    Decimal  @db.Decimal(10, 2)
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@index([person])
  @@index([category])
}

model CalendarEvent {
  id        String   @id @default(cuid())
  date      DateTime
  time      String
  title     String
  type      String
  owner     String
  place     String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@index([owner])
}

model FamilyTask {
  id        String   @id @default(cuid())
  title     String
  owner     String
  due       DateTime
  priority  String
  done      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([done])
  @@index([due])
}

model GroceryItem {
  id        String   @id @default(cuid())
  item      String
  quantity  String?
  done      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([done])
}

model UsefulContact {
  id        String   @id @default(cuid())
  name      String
  role      String
  phone     String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BudgetItem {
  id        String   @id @default(cuid())
  month     String   @default("2026-06")
  kind      String
  name      String
  owner     String
  category  String
  amount    Decimal  @db.Decimal(10, 2)
  note      String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  monthlyAdjustments BudgetItemAdjustment[]

  @@index([month])
  @@index([kind])
  @@index([active])
}

model BudgetItemAdjustment {
  id           String     @id @default(cuid())
  budgetItemId String
  month        String
  amount       Decimal    @db.Decimal(10, 2)
  note         String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  budgetItem BudgetItem @relation(fields: [budgetItemId], references: [id], onDelete: Cascade)

  @@unique([budgetItemId, month])
  @@index([month])
}